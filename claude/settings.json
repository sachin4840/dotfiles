{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[[ \"$file\" == *.env* ]] && echo '{\"decision\":\"block\"}'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -message 'Claude needs your attention' -title 'Claude Code' -sound Glass && say 'Claude needs permission'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -message 'Task completed' -title 'Claude Code Complete' -sound Glass && say 'Claude finished'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/sachin/.claude/hooks/gsd-check-update.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/sachin/.claude/hooks/gsd-context-monitor.js\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"/Users/sachin/.claude/hooks/gsd-statusline.js\""
  },
  "enabledPlugins": {
    "get-shit-done@get-shit-done": true
  },
  "alwaysThinkingEnabled": true,
  "model": "opus"
}
